{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "restaurant-route": {
        "ClusterId": "restaurant-cluster",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}"
        }
      },
      "ordering-route": {
        "ClusterId": "ordering-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "delivery-route": {
        "ClusterId": "delivery-cluster",
        "Match": {
          "Path": "/api/deliveries/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "restaurant-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5047/"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5045/"
          }
        }
      },
      "ordering-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5189/"
          }
        }
      },
      "delivery-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5143/"
          }
        }
      }
    }
  }
}